{
  "name": "AI Governance Copilot",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Copilot app", "onAutoForward": "openPreview" } },
  "secrets": {
    "GOOGLE_API_KEY": { "description": "Free Gemini API key from https://aistudio.google.com/apikey" }
  },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
